{
  "name": "miso",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "gen:licenses": "node scripts/licenses.mjs",
    "check:licenses": "node scripts/licenses.mjs --check",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "vitest run --project unit",
    "test:layout": "vitest run --project layout",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "verify": "pnpm check:licenses && pnpm lint:rust && pnpm test:rust && pnpm check && pnpm test && pnpm test:layout",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/hyphen": "^1.14.0",
    "@vitest/browser-playwright": "^5.1.0",
    "playwright": "^1.65.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "hyphen": "1.14.1"
  }
}
